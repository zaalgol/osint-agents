# Copy to .env and adjust. Values here override config/settings.yaml.
# Nested keys use double underscores, e.g. OSINT_POSTGRES__PASSWORD.
OSINT_POSTGRES__PASSWORD=osint
OSINT_NEO4J__PASSWORD=osint-neo4j-pw
POSTGRES_PASSWORD=osint
NEO4J_PASSWORD=osint-neo4j-pw
SEARXNG_SECRET=change-me-to-a-long-random-string
